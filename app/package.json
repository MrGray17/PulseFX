{
  "name": "pulsefx-control",
  "productName": "PulseFX",
  "private": true,
  "version": "0.2.0",
  "description": "PulseFX system-wide audio enhancement controller",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron . --dev",
    "dev": "concurrently -k -n web,desktop \"npm:dev:web\" \"npm:dev:electron\"",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.4",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "vite": "8.2.2",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "dev.pulsefx.desktop",
    "productName": "PulseFX",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/Release/pulsefx_audio_host.exe",
        "to": "native/pulsefx_audio_host.exe"
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "PulseFX-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
